{
  "permissions": {
    "allow": [
      "Bash(bun install:*)",
      "Bash(bun add:*)",
      "Bash(bun test:*)",
      "Bash(bun run:*)",
      "Bash(bunx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-commit.ts",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
